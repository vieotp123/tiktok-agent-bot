[Unit]
Description=TikTok Bot Backend (FastAPI)
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/tiktok-bot
EnvironmentFile=/opt/tiktok-bot/.env
ExecStart=/opt/tiktok-bot/venv/bin/uvicorn backend.server:app --host 127.0.0.1 --port 8000 --workers 1
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=tiktok-backend

[Install]
WantedBy=multi-user.target
